# ============================================================
# MindBridge AI - Environment Configuration Template
# ============================================================

# 1. Google Gemini AI API Key (REQUIRED for backend reflection & problem solving)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. Application URL
APP_URL="http://localhost:3000"

# 3. Optional: Firebase Web Client Config Overrides (or use firebase-applet-config.json)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_MEASUREMENT_ID=""

# 4. Server Port (defaults to 3000)
PORT=3000
